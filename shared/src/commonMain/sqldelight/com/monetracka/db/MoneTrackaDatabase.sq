CREATE TABLE IF NOT EXISTS CategoryEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    emoji TEXT NOT NULL,
    colorIndex INTEGER NOT NULL DEFAULT 0,
    type TEXT NOT NULL,
    isDefault INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE IF NOT EXISTS AccountEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    emoji TEXT NOT NULL,
    initialBalance REAL NOT NULL DEFAULT 0.0,
    description TEXT NOT NULL DEFAULT ''
);

CREATE TABLE IF NOT EXISTS UserProfileEntity (
    id INTEGER PRIMARY KEY DEFAULT 1,
    userName TEXT NOT NULL DEFAULT 'User',
    currency TEXT NOT NULL DEFAULT 'USD',
    hasCompletedOnboarding INTEGER NOT NULL DEFAULT 0,
    monthlyBudgetLimit REAL NOT NULL DEFAULT 2500.0,
    isBiometricEnabled INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS TransactionEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    amount REAL NOT NULL,
    type TEXT NOT NULL,
    categoryId INTEGER NOT NULL,
    accountId INTEGER NOT NULL DEFAULT 1,
    toAccountId INTEGER,
    note TEXT NOT NULL DEFAULT '',
    dateMillis INTEGER NOT NULL,
    createdAtMillis INTEGER NOT NULL,
    FOREIGN KEY (categoryId) REFERENCES CategoryEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS ExchangeRateEntity (
    fromCurrency TEXT NOT NULL,
    toCurrency TEXT NOT NULL,
    rate REAL NOT NULL,
    updatedAtMillis INTEGER NOT NULL,
    PRIMARY KEY (fromCurrency, toCurrency)
);

CREATE TABLE IF NOT EXISTS CategoryBudgetEntity (
    categoryId INTEGER PRIMARY KEY,
    monthlyLimit REAL NOT NULL,
    rolloverEnabled INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (categoryId) REFERENCES CategoryEntity(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS RecurringTransactionEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    amount REAL NOT NULL,
    type TEXT NOT NULL,
    categoryId INTEGER NOT NULL,
    accountId INTEGER NOT NULL DEFAULT 1,
    intervalType TEXT NOT NULL,
    intervalCount INTEGER NOT NULL DEFAULT 1,
    nextDueDateMillis INTEGER NOT NULL,
    autoPost INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY (categoryId) REFERENCES CategoryEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS SavingsGoalEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    targetAmount REAL NOT NULL,
    currentAmount REAL NOT NULL DEFAULT 0.0,
    emoji TEXT NOT NULL DEFAULT '🎯',
    deadlineMillis INTEGER,
    targetAccountId INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY (targetAccountId) REFERENCES AccountEntity(id) ON DELETE CASCADE
);



CREATE INDEX idx_transaction_date ON TransactionEntity(dateMillis);
CREATE INDEX idx_transaction_category ON TransactionEntity(categoryId);
CREATE INDEX idx_transaction_account ON TransactionEntity(accountId);
CREATE INDEX idx_transaction_type ON TransactionEntity(type);

-- Category Queries
getAllCategories:
SELECT * FROM CategoryEntity ORDER BY name ASC;

insertCategory:
INSERT INTO CategoryEntity(name, emoji, colorIndex, type, isDefault)
VALUES (?, ?, ?, ?, ?);

deleteCategory:
DELETE FROM CategoryEntity WHERE id = ?;

lastInsertedCategoryId:
SELECT last_insert_rowid();

getCategoryCount:
SELECT COUNT(*) FROM CategoryEntity;

-- Account Queries
getAllAccounts:
SELECT * FROM AccountEntity ORDER BY id ASC;

insertAccount:
INSERT INTO AccountEntity(name, emoji, initialBalance, description)
VALUES (?, ?, ?, ?);

updateAccount:
UPDATE AccountEntity
SET name = ?, emoji = ?, initialBalance = ?, description = ?
WHERE id = ?;

deleteAccount:
DELETE FROM AccountEntity WHERE id = ?;

getAccountCount:
SELECT COUNT(*) FROM AccountEntity;

lastInsertedAccountId:
SELECT last_insert_rowid();

-- Transaction Queries
getAllTransactions:
SELECT * FROM TransactionEntity ORDER BY dateMillis DESC;

searchTransactions:
SELECT * FROM TransactionEntity
WHERE note LIKE ('%' || :query || '%')
ORDER BY dateMillis DESC;


insertTransaction:
INSERT INTO TransactionEntity(amount, type, categoryId, accountId, toAccountId, note, dateMillis, createdAtMillis)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateTransaction:
UPDATE TransactionEntity
SET amount = ?, type = ?, categoryId = ?, accountId = ?, toAccountId = ?, note = ?, dateMillis = ?
WHERE id = ?;

deleteTransaction:
DELETE FROM TransactionEntity WHERE id = ?;

lastInsertedTransactionId:
SELECT last_insert_rowid();

-- User Profile Queries
getUserProfile:
SELECT * FROM UserProfileEntity WHERE id = 1 LIMIT 1;

insertOrUpdateUserProfile:
INSERT OR REPLACE INTO UserProfileEntity(id, userName, currency, hasCompletedOnboarding, monthlyBudgetLimit, isBiometricEnabled)
VALUES (1, ?, ?, ?, ?, ?);

updateMonthlyBudget:
UPDATE UserProfileEntity SET monthlyBudgetLimit = ? WHERE id = 1;

updateCurrency:
UPDATE UserProfileEntity SET currency = ? WHERE id = 1;

updateBiometricEnabled:
UPDATE UserProfileEntity SET isBiometricEnabled = ? WHERE id = 1;

getUserProfileCount:
SELECT COUNT(*) FROM UserProfileEntity;


-- Exchange Rate Queries
getExchangeRate:
SELECT * FROM ExchangeRateEntity WHERE fromCurrency = ? AND toCurrency = ? LIMIT 1;

getAllExchangeRates:
SELECT * FROM ExchangeRateEntity;

insertOrUpdateExchangeRate:
INSERT OR REPLACE INTO ExchangeRateEntity(fromCurrency, toCurrency, rate, updatedAtMillis)
VALUES (?, ?, ?, ?);

getExchangeRateCount:
SELECT COUNT(*) FROM ExchangeRateEntity;

-- Category Budget Queries
getAllCategoryBudgets:
SELECT * FROM CategoryBudgetEntity;

getCategoryBudget:
SELECT * FROM CategoryBudgetEntity WHERE categoryId = ? LIMIT 1;

insertOrUpdateCategoryBudget:
INSERT OR REPLACE INTO CategoryBudgetEntity(categoryId, monthlyLimit, rolloverEnabled)
VALUES (?, ?, ?);

deleteCategoryBudget:
DELETE FROM CategoryBudgetEntity WHERE categoryId = ?;

-- Recurring Transaction Queries
getAllRecurringTransactions:
SELECT * FROM RecurringTransactionEntity ORDER BY nextDueDateMillis ASC;

getDueRecurringTransactions:
SELECT * FROM RecurringTransactionEntity WHERE nextDueDateMillis <= :currentMillis AND autoPost = 1;

insertRecurringTransaction:
INSERT INTO RecurringTransactionEntity(title, amount, type, categoryId, accountId, intervalType, intervalCount, nextDueDateMillis, autoPost)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateRecurringNextDueDate:
UPDATE RecurringTransactionEntity SET nextDueDateMillis = ? WHERE id = ?;

deleteRecurringTransaction:
DELETE FROM RecurringTransactionEntity WHERE id = ?;

-- Savings Goal Queries
getAllSavingsGoals:
SELECT * FROM SavingsGoalEntity ORDER BY id ASC;

getSavingsGoalById:
SELECT * FROM SavingsGoalEntity WHERE id = ?;

insertSavingsGoal:
INSERT INTO SavingsGoalEntity(name, targetAmount, currentAmount, emoji, deadlineMillis, targetAccountId)
VALUES (?, ?, ?, ?, ?, ?);

updateSavingsGoalAmount:
UPDATE SavingsGoalEntity SET currentAmount = ? WHERE id = ?;

deleteSavingsGoal:
DELETE FROM SavingsGoalEntity WHERE id = ?;



